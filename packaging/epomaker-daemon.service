[Unit]
Description=Epomaker keyboard status daemon (CPU / temperature on the screen)
Documentation=https://github.com/jonathanmajh/epomaker-controller
# The daemon talks to a USB HID device; make sure udev has granted the
# active seat an ACL (TAG+="uaccess") before starting.
After=graphical-session.target
PartOf=graphical-session.target
# The daemon waits for a missing keyboard itself (it retries forever, backing
# off to one attempt every 30s), so an absent or unplugged keyboard never makes
# the process exit. This limit is only a brake for genuine crash loops, e.g. a
# broken install: 5 failed starts in 5 minutes and systemd stops retrying.
# (A start request that arrives from udev inside that window is refused too;
# `systemctl --user reset-failed epomaker-daemon` clears it.)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# install-daemon.sh rewrites this to the absolute path of the
# epomakercontroller that is on PATH (i.e. the one in your venv).
ExecStart=/usr/bin/env epomakercontroller start-daemon
# Restart after a crash. Device errors don't count: the daemon retries those
# forever on its own (--reconnect-attempts defaults to 0 = no limit).
Restart=on-failure
RestartSec=5s
# Set EPOMAKER_TEMP_KEY to show a temperature as well, e.g.:
#   systemctl --user edit epomaker-daemon
#   [Service]
#   Environment=EPOMAKER_TEMP_KEY=coretemp-0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
