[Unit]
Description=Epomaker keyboard status daemon (CPU / temperature on the screen)
Documentation=https://github.com/jonathanmajh/epomaker-controller
# The daemon talks to a USB HID device; make sure udev has granted the
# active seat an ACL (TAG+="uaccess") before starting.
After=graphical-session.target
PartOf=graphical-session.target
# Give up after 5 restarts in a minute: enough to ride out a replug, not
# enough to spin forever on a config error.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# install-daemon.sh rewrites this to the absolute path of the
# epomakercontroller that is currently on PATH (i.e. the one in your venv).
ExecStart=/usr/bin/env epomakercontroller start-daemon
Restart=on-failure
RestartSec=5s
# The daemon reconnects with backoff on its own, so a simple restart is enough.
TimeoutStopSec=10
# Send logs to the journal at INFO; the per-update lines are DEBUG.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target